# The pinned stack. Never latest.
# DIGESTS beside the tags for the family images this stack pulls.
# `emulator-sail:X` and `emulator-spark-agent:X` are tagged for the dependency
# they carry, not their content -- both also ship first-party code that moves
# independently, so one tag can be republished over different bytes.
# fabric-emulator enforces @sha256 on every reference inside its own repository
# and its consumers were not covered.
#
# Docker IGNORES the tag in `repo:tag@sha256:...`, so a digest and a version
# that disagree do not fail -- the digest silently wins. Two consequences:
# set_release.py moves DATABRICKS_EMULATOR_DIGEST with its version, and anyone
# bumping SAIL_ENGINE_VERSION or SPARK_CLIENT_VERSION by hand must run
# scripts/refresh_digests.py rather than edit one line.
DATABRICKS_EMULATOR_VERSION=0.2.9
DATABRICKS_EMULATOR_DIGEST=sha256:c2ab6d0fecc2e9b954f9141661408fe2161eb19591ac9429886228667b47ebd2
# SAIL_ENGINE and SPARK_CLIENT are tagged for the DEPENDENCY they carry --
# pysail and pyspark-client -- because that is what a consumer pins them for.
# They used to be pinned on fabric-emulator's release number, which reads tidier
# and tells you nothing: `emulator-sail:0.33.0` does not say which Sail is
# inside, and both tags are published over the same bytes. Three fields, three
# jobs: _VERSION is the tag (what Sail you get), _DIGEST is the identity (which
# build exactly), _RELEASE is the fabric-emulator release that packaged it, read
# from the image's own org.opencontainers.image.version label.
#
# _RELEASE is DERIVED, never typed: refresh_digests.py writes it and CI re-reads
# the label off the pinned digest and fails if this file disagrees.
SAIL_ENGINE_VERSION=0.7.0
SAIL_ENGINE_DIGEST=sha256:35b85900cd0f82781a26a7aadc32e5f18ab3e43e5a9c1851b8f6342b2bed8ccf
SAIL_ENGINE_RELEASE=0.33.0
SPARK_CLIENT_VERSION=4.2.0
SPARK_CLIENT_DIGEST=sha256:ea4b9df90d0f5094ad719e5f6fe1aa7d2aecfdbfcbe1027f69c4fce22d1bd58b
SPARK_CLIENT_RELEASE=0.33.0
UC_VERSION=v0.5.0
UC_DIGEST=sha256:c664f371629059f17d778c0da6d1623a4496bd7e6a72f3e17d972c13832315de
ENTRA_EMULATOR_VERSION=0.9.0
ENTRA_EMULATOR_DIGEST=sha256:19418a503b6459d1f9db4e0d7657f78bf01655269ce7abef968fd5d1eb80da86
KEYVAULT_EMULATOR_VERSION=0.7.0
KEYVAULT_EMULATOR_DIGEST=sha256:e58e8ed3ebad1557b5b2a96280c0ec7ebbd92151183ca6539c89435f29ab1def
OPENMETADATA_VERSION=1.13.2
OPENMETADATA_SERVER_DIGEST=sha256:f5cdd8b6223b47acbce76b6036a8ae802967dc297732846bedc911b05ae9d300
OPENMETADATA_PG_DIGEST=sha256:7c71755ed605fbe7f2687110b5604ff114e28d94174f3e9ae4f208780d1c805b
OPENSEARCH_VERSION=3.4.0
OPENSEARCH_DIGEST=sha256:1647ce2e07371f1ac8bbad28890a64ef77c5a694a61f656120f0ace09e66bf48

# The vendor simulators are NOT pinned here. contoso-sources pins them, and
# scripts/sources.py reads that repo's versions.env -- because two platforms
# on different mokapis are not pulling from the same vendor even if the specs
# match, and this platform's gold numbers are only comparable with the Fabric
# one's if the bytes were identical.
